{
  "name": "oneclaude",
  "private": true,
  "os": ["darwin", "linux"],
  "cpu": ["arm64", "x64"],
  "type": "module",
  "scripts": {
    "test": "bun test"
  },
  "cmod": {
    "install": "./setup/install.sh",
    "uninstall": "./setup/uninstall.sh",
    "program": "oneclaude",
    "permissions": {
      "network": ["127.0.0.1"],
      "config": ["env.ANTHROPIC_BASE_URL"],
      "prompt": true
    }
  },
  "files": [
    "hooks",
    "setup",
    "src",
    "types"
  ],
  "dependencies": {
    "@cmodjs/core": "^4.3.2"
  }
}
